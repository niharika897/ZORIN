# =========================================================
# ZORIN AI ASSISTANT - PRODUCTION CONFIGURATION TEMPLATE
# Copy this file to .env and insert your real credentials.
# NEVER commit your actual .env file or API keys to GitHub.
# =========================================================

# Google Gemini API Key (Required for AI Brain & Voice)
GEMINI_API_KEY=your_gemini_api_key_here

# Assistant Configuration
ASSISTANT_NAME=ZORIN
GEMINI_MODEL=gemini-3.1-flash-live-preview
WAKE_WORD=Hey Zorin

# Server Configuration
HOST=0.0.0.0
PORT=8000
SERVER_SECRET_KEY=change_this_to_a_secure_random_hex_key

# Audio Settings
INPUT_SAMPLE_RATE=16000
OUTPUT_SAMPLE_RATE=24000
AUDIO_CHANNELS=1

# Storage Paths
DATA_DIR=data
MODELS_DIR=models
